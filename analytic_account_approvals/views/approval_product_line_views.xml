<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Inherit the approval product line view to add the analytic account field -->
    <record id="approval_product_line_view_tree_inherit" model="ir.ui.view">
        <field name="name">approval.product.line.tree.inherit</field>
        <field name="model">approval.product.line</field>
        <field name="inherit_id" ref="approvals.approval_product_line_view_tree"/>
        <field name="arch" type="xml">
            <field name="product_uom_id" position="after">
                <field name="analytic_account_id" optional="hide" groups="analytic.group_analytic_accounting"/>
                <field name="analytic_distribution" widget="analytic_distribution" optional="show" 
                       groups="analytic.group_analytic_accounting"
                       options="{'product_field': 'product_id', 'business_domain': 'purchase_order'}"/>
            </field>
        </field>
    </record>

    <!-- Inherit the approval product line form view -->
    <record id="approval_product_line_view_form_inherit" model="ir.ui.view">
        <field name="name">approval.product.line.form.inherit</field>
        <field name="model">approval.product.line</field>
        <field name="inherit_id" ref="approvals.approval_product_line_view_form"/>
        <field name="arch" type="xml">
            <field name="product_uom_id" position="after">
                <field name="analytic_account_id" groups="analytic.group_analytic_accounting"/>
                <field name="analytic_distribution" widget="analytic_distribution" 
                       groups="analytic.group_analytic_accounting"
                       options="{'product_field': 'product_id', 'business_domain': 'purchase_order'}"/>
            </field>
        </field>
    </record>
</odoo> 