<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_out_invoice_tree_inherit_so_fields" model="ir.ui.view">
        <field name="name">account.move.tree.inherit.so.fields</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_out_invoice_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//tree" position="inside">
                <field name="so_tipo_negocio" optional="hide"/>
                <field name="so_business_unit_id" optional="hide"/>
                <field name="so_margen_teorico_display" optional="hide"/>
            </xpath>
        </field>
    </record>
    <record id="view_out_credit_note_tree_inherit_so_fields" model="ir.ui.view">
        <field name="name">account.move.credit.note.tree.inherit.so.fields</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_out_credit_note_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//tree" position="inside">
                <field name="so_tipo_negocio" optional="hide"/>
                <field name="so_business_unit_id" optional="hide"/>
                <field name="so_margen_teorico_display" optional="hide"/>
            </xpath>
        </field>
    </record>
</odoo> 