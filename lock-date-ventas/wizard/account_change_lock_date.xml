<odoo>
    <data>
        <record id="view_account_change_lock_date_inherit" model="ir.ui.view">
            <field name="name">account.change.lock.date.inherit.form</field>
            <field name="model">account.change.lock.date</field>
            <field name="inherit_id" ref="account_accountant.view_account_change_lock_date"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='fiscalyear_lock_date']" position="after">
                    <field name="sales_lock_date" placeholder="Elija una fecha que bloquear" options="{'datepicker': {'warn_future': true}}"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
