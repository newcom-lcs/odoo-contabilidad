<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Customer Invoice Tree View -->
    <record id="view_out_invoice_tree_inherit_multicurrency" model="ir.ui.view">
        <field name="name">account.view.out.invoice.tree.inherit.multicurrency</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_out_invoice_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//tree" position="inside">
                <field name="amount_total_second_currency" widget="monetary" sum="true" optional="hide"/>
                <field name="amount_untaxed_signed_second_currency" widget="monetary" sum="true" optional="hide"/>
                <field name="amount_tax_second_currency" widget="monetary" sum="true" optional="hide"/>
            </xpath>
        </field>
    </record>

    <!-- Vendor Bill Tree View -->
    <record id="view_in_invoice_bill_tree_inherit_multicurrency" model="ir.ui.view">
        <field name="name">account.view.in.invoice.bill.tree.inherit.multicurrency</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_in_invoice_bill_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//tree" position="inside">
                <field name="amount_total_second_currency" widget="monetary" sum="true" optional="hide"/>
                <field name="amount_untaxed_signed_second_currency" widget="monetary" sum="true" optional="hide"/>
                <field name="amount_tax_second_currency" widget="monetary" sum="true" optional="hide"/>
            </xpath>
        </field>
    </record>
</odoo> 