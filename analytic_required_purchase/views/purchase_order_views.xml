<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_purchase_order_form_inherit_analytic_required" model="ir.ui.view">
        <field name="name">purchase.order.form.inherit.analytic.required</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']/tree/field[@name='product_id']" position="after">
                <field name="requires_analytic" invisible="1"/>
            </xpath>
            <field name="analytic_distribution" position="attributes">
                <attribute name="attrs">{'required': [('requires_analytic', '=', True)]}</attribute>
            </field>
        </field>
    </record>
</odoo> 