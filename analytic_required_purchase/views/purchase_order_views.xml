<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Purchase Order Views -->
    <record id="view_purchase_order_form_inherit_analytic_required" model="ir.ui.view">
        <field name="name">purchase.order.form.inherit.analytic.required</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']/tree/field[@name='product_id']" position="after">
                <field name="requires_analytic" invisible="1"/>
            </xpath>
            <field name="analytic_distribution" position="attributes">
                <attribute name="attrs">{'readonly': [('requires_analytic', '=', False)], 'required': [('requires_analytic', '=', True)]}</attribute>
            </field>
        </field>
    </record>

    <!-- Vendor Bill Views -->
    <record id="view_account_move_form_inherit_analytic_required" model="ir.ui.view">
        <field name="name">account.move.form.inherit.analytic.required</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_line_ids']/tree/field[@name='product_id']" position="after">
                <field name="requires_analytic" invisible="1"/>
            </xpath>
            <field name="analytic_distribution" position="attributes">
                <attribute name="attrs">{'readonly': [('requires_analytic', '=', False)], 'required': [('requires_analytic', '=', True)]}</attribute>
            </field>
        </field>
    </record>
</odoo> 