<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Extend stock valuation layer tree view -->
        <record id="stock_valuation_layer_tree_inherit" model="ir.ui.view">
            <field name="name">stock.valuation.layer.tree.inherit</field>
            <field name="model">stock.valuation.layer</field>
            <field name="inherit_id" ref="stock_account.stock_valuation_layer_tree"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='create_date']" position="after">
                    <field name="numero_orden" optional="show"/>
                    <field name="cantidad_facturada" optional="show"/>
                </xpath>
            </field>
        </record>

        <!-- Server Action for updating pending moves -->
        <record id="action_update_pending_moves" model="ir.actions.server">
            <field name="name">Actualizar Movimientos Pendientes</field>
            <field name="model_id" ref="stock_account.model_stock_valuation_layer"/>
            <field name="state">code</field>
            <field name="code">
# Get all stock valuation layers and update their computed fields
layers = model.search([])
layers._compute_orden_info()

# Show success message
action = {
    'type': 'ir.actions.client',
    'tag': 'display_notification',
    'params': {
        'title': 'Actualización Completada',
        'message': f'Se actualizaron {len(layers)} registros de capas de valuación',
        'type': 'success',
        'sticky': False,
    }
}
            </field>
        </record>

        <!-- Scheduled Action for manual execution -->
        <record id="ir_cron_update_pending_moves" model="ir.cron">
            <field name="name">Actualizar Movimientos Pendientes - Manual</field>
            <field name="model_id" ref="stock_account.model_stock_valuation_layer"/>
            <field name="state">code</field>
            <field name="code">
# Get all stock valuation layers and update their computed fields
layers = model.search([])
layers._compute_orden_info()
            </field>
            <field name="interval_number">0</field>
            <field name="interval_type">days</field>
            <field name="numbercall">0</field>
            <field name="doall" eval="False"/>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo> 