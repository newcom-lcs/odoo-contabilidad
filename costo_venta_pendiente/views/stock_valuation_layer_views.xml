<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Extend stock valuation layer tree view -->
        <record id="stock_valuation_layer_tree_inherit" model="ir.ui.view">
            <field name="name">stock.valuation.layer.tree.inherit</field>
            <field name="model">stock.valuation.layer</field>
            <field name="inherit_id" ref="stock_account.stock_valuation_layer_tree"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='create_date']" position="after">
                    <field name="numero_orden" optional="show"/>
                    <field name="cantidad_facturada" optional="show"/>
                </xpath>
                <xpath expr="//header" position="inside">
                    <button name="update_all_pending_moves" 
                            string="Actualizar Movimientos Pendientes" 
                            type="object" 
                            class="btn-primary"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo> 